{
  "name": "null-star",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An interactive Y2K deep-space transmission for the web.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "vite build",
    "browsers:install": "playwright install chromium firefox",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "audit": "npm audit --audit-level=moderate",
    "lint": "eslint .",
    "test": "npm run build && playwright test",
    "test:update-snapshots": "npm run build && playwright test tests/visual.spec.js --update-snapshots",
    "check": "npm run lint && npm test"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "packageManager": "npm@10.9.2",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/azeret-mono": "^5.3.0",
    "@playwright/test": "1.61.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "vite": "^8.1.5"
  }
}
