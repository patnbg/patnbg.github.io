{
  "name": "daily-detour",
  "version": "1.0.0",
  "private": true,
  "description": "A small daily dose of comic relief.",
  "type": "module",
  "scripts": {
    "dev": "bun x --bun vite --host 127.0.0.1 --port 4173",
    "build": "bun x --bun vite build",
    "preview": "bun x --bun vite preview --host 127.0.0.1 --port 4173",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "lint:effect": "effect-tsgo diagnostics --project tsconfig.json",
    "typecheck": "bun x --bun tsc --noEmit",
    "test:unit": "bun test src",
    "test:e2e": "bun x --bun playwright test",
    "test:update-snapshots": "bun x --bun playwright test tests/visual.spec.ts --update-snapshots",
    "browsers:install": "bun x --bun playwright install chromium firefox webkit",
    "audit": "bun audit --audit-level=moderate",
    "check": "bun run format:check && bun run lint && bun run lint:effect && bun run typecheck && bun run test:unit && bun run build && bun run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/azeret-mono": "5.3.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "effect": "3.22.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@effect/tsgo": "0.41.0",
    "@playwright/test": "1.62.1",
    "@types/bun": "1.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "engines": {
    "bun": "1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
